// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")     
}

model Product {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  brand            String
  category         String
  price            Float
  originalPrice    Float?
  discountPercent  Int?
  rating           Float    @default(0)
  reviewsCount     Int      @default(0)
  image            String
  images           String[] @default([])
  inStock          Boolean  @default(true)
  stockCount       Int      @default(0)
  isFeatured       Boolean  @default(false)
  isHotDeal        Boolean  @default(false)
  shortDescription String?
  
  // Specifications (stored as JSON)
  processor        String?
  ram              String?
  storage          String?
  gpu              String?
  display          String?
  weight           String?
  warranty         String?
  color            String?
  battery          String?
  camera           String?
  os               String?
  connectivity     String?
  dimensions       String?
  
  // Details tab content
  details          String?  @db.Text
  
  // Q&A stored as JSON string: [{question, answer}]
  qna              Json?
  
  // Reviews stored as JSON string: [{user, rating, comment, date}]
  reviews          Json?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([category])
  @@index([brand])
  @@index([isFeatured])
  @@index([isHotDeal])
  @@index([slug])
}
